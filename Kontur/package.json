{
  "name": "kontur",
  "version": "0.2.0",
  "private": true,
  "description": "Движок векторной анимации: ключевые кадры, морфинг, процедурное движение, MCP-сервер",
  "type": "module",
  "files": [
    "engine/",
    "mcp/",
    "player/",
    "scripts/",
    "docs/",
    "examples/*.json",
    "examples/assets/"
  ],
  "main": "engine/kontur.js",
  "bin": {
    "kontur-mcp": "mcp/server.mjs",
    "kontur-render": "scripts/render.mjs"
  },
  "scripts": {
    "mcp": "node mcp/server.mjs",
    "preview": "node mcp/server.mjs --preview --scene examples/flow.json",
    "demos": "node examples/build-demos.mjs",
    "test": "node test/run.mjs",
    "lint": "node scripts/lint.mjs && eslint .",
    "typecheck": "tsc -p .",
    "build:page": "node scripts/build-artifact.mjs dist/kontur-studio.html",
    "test:golden": "node test/golden.mjs",
    "golden:update": "node test/golden.mjs --update",
    "bench": "node test/bench.mjs",
    "build:engine": "node mcp/bundle.mjs dist/kontur.js",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "webgpu": "^0.6.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  }
}
